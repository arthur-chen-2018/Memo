{
	"_version": "2.0.0",

	"sap.app": {
		"id": "memo.app",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "${version}"
		}
	},

	"sap.ui": {
		"technology": "UI5",
		"icons": {},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},

	"sap.ui5": {
		"rootView": {
			"viewName": "memo.app.view.App",
			"type": "XML",
			"id": "appView"
		},

		"dependencies": {
			"minUI5Version": "1.144.1",
			"libs": {
				"sap.ui.core": {},
				"sap.m": {},
				"sap.f": {},
				"sap.uxap": {},
				"sap.ui.layout": {},
				"sap.ui.unified": {}
			}
		},

		"flexEnabled": false,
		"handleValidation": true,

		"contentDensities": {
			"compact": true,
			"cozy": true
		},

		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "memo.app.i18n.i18n",
					"async": true
				}
			}
		},

		"resources": {
			"css": [
				{
					"uri": "css/style.css"
				}
			]
		},

		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"type": "View",
				"viewType": "XML",
				"path": "memo.app.view",
				"controlId": "appContainer",
				"controlAggregation": "pages"
			},
			"routes": [
				{
					"pattern": "",
					"name": "memoList",
					"target": "memoList"
				},
				{
					"pattern": "memo/{memoId}",
					"name": "memoConversation",
					"target": "memoConversation"
				},
				{
					"pattern": "errors",
					"name": "errorMonitor",
					"target": "errorMonitor"
				}
			],
			"targets": {
				"memoList": {
					"id": "memoList",
					"name": "MemoList"
				},
				"memoConversation": {
					"id": "memoConversation",
					"name": "MemoConversation"
				},
				"errorMonitor": {
					"id": "errorMonitor",
					"name": "ErrorMonitor"
				}
			}
		}
	}
}
