<mvc:View
	controllerName="memo.app.controller.ErrorMonitor"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:html="sap.ui.core">

	<Page
		id="errorMonitorPage"
		showHeader="false"
		showNavButton="true"
		navButtonPress=".onNavBack"
		class="sapUiResponsiveContentPadding">

		<content>
			<VBox class="errorMonitorContent">
				<Title text="{i18n>errorMonitorTitle}" level="H3" class="sapUiSmallMarginBottom" />

				<!-- Filter Bar -->
				<OverflowToolbar class="sapUiSmallMarginBottom">
					<Label text="{i18n>colErrorType}" labelFor="errFilterType" />
					<Select id="errFilterType" width="10rem">
						<core:Item key="" text="All Types" />
						<core:Item key="API Timeout" text="API Timeout" />
						<core:Item key="Validation Error" text="Validation Error" />
					</Select>

					<Label text="{i18n>filterStatus}" labelFor="errFilterStatus" />
					<Select id="errFilterStatus" width="10rem">
						<core:Item key="" text="All Statuses" />
						<core:Item key="Unresolved" text="Unresolved" />
						<core:Item key="Retrying" text="Retrying" />
						<core:Item key="Resolved" text="Resolved" />
					</Select>

					<Label text="{i18n>filterWorkOrder}" labelFor="errFilterWO" />
					<Input id="errFilterWO" placeholder="e.g. 40001234" width="10rem" />

					<ToolbarSpacer />
					<Button text="Go" type="Emphasized" press=".onFilterGo" />
					<Button text="Clear" press=".onFilterClear" />
				</OverflowToolbar>

				<!-- Error List -->
				<List
					id="errorList"
					items="{viewModel>/errors}"
					mode="None">
					<CustomListItem type="Inactive">
						<VBox>
							<!-- Summary row -->
							<HBox
								alignItems="Center"
								class="sapUiSmallMargin">
								<VBox width="6rem" class="sapUiTinyMarginEnd">
									<Label text="{i18n>colErrorId}" design="Bold" />
									<Text text="{viewModel>id}" />
								</VBox>
								<VBox width="10rem" class="sapUiTinyMarginEnd">
									<Label text="{i18n>colTimestamp}" design="Bold" />
									<Text text="{viewModel>timestamp}" />
								</VBox>
								<VBox width="7rem" class="sapUiTinyMarginEnd">
									<Label text="{i18n>colDirection}" design="Bold" />
									<ObjectStatus
										text="{viewModel>direction}"
										state="{= ${viewModel>direction} === 'Inbound' ? 'Information' : 'Warning' }" />
								</VBox>
								<VBox width="9rem" class="sapUiTinyMarginEnd">
									<Label text="{i18n>colErrorType}" design="Bold" />
									<Text text="{viewModel>errorType}" />
								</VBox>
								<VBox width="8rem" class="sapUiTinyMarginEnd">
									<Label text="{i18n>colWorkOrder}" design="Bold" />
									<Link text="{viewModel>workOrderNumber}" press=".onWOLinkPress" />
								</VBox>
								<VBox width="8rem" class="sapUiTinyMarginEnd">
									<Label text="Job Number" design="Bold" />
									<Text text="{viewModel>jobNumber}" />
								</VBox>
								<VBox width="7rem" class="sapUiTinyMarginEnd">
									<Label text="{i18n>colStream}" design="Bold" />
									<Text text="{viewModel>streamNumber}" />
								</VBox>
								<VBox class="sapUiTinyMarginEnd" width="16rem">
									<Label text="{i18n>colErrorDetail}" design="Bold" />
									<Text text="{viewModel>errorDetail}" maxLines="1" />
								</VBox>
								<VBox width="8rem" class="sapUiTinyMarginEnd">
									<Label text="{i18n>colStatus}" design="Bold" />
									<ObjectStatus
										text="{viewModel>status}"
										state="{
											path: 'viewModel>status',
											formatter: '.formatter.errorStatusState'
										}" />
								</VBox>
								<HBox>
									<Button
										icon="sap-icon://refresh"
										type="Transparent"
										tooltip="{i18n>retryBtn}"
										press=".onRetryPress"
										visible="{= ${viewModel>status} !== 'Resolved' }" />
									<Button
										icon="sap-icon://accept"
										type="Transparent"
										tooltip="{i18n>resolveBtn}"
										press=".onResolvePress"
										visible="{= ${viewModel>status} !== 'Resolved' }" />
									<Button
										icon="sap-icon://navigation-down-arrow"
										type="Transparent"
										tooltip="Expand"
										press=".onToggleExpand" />
								</HBox>
							</HBox>

							<!-- Expandable detail area -->
							<VBox
								class="errorExpanded"
								visible="{viewModel>expanded}">
								<Panel headerText="{i18n>fullErrorHeader}" expandable="true" expanded="true">
									<MessageStrip
										text="{viewModel>fullErrorMessage}"
										type="Error"
										showCloseButton="false"
										class="errorExpandedContent" />
								</Panel>
								<Panel headerText="{i18n>originalPayloadHeader}" expandable="true" expanded="false">
									<VBox class="errorExpandedContent">
										<html:HTML content="&lt;pre class='errorPayload'&gt;{viewModel>originalPayload}&lt;/pre&gt;" />
									</VBox>
								</Panel>
								<Panel headerText="{i18n>retryHistoryHeader}" expandable="true" expanded="{= ${viewModel>retryHistory}.length > 0 }">
									<VBox class="errorExpandedContent">
										<Text
											text="{i18n>noRetries}"
											visible="{= ${viewModel>retryHistory}.length === 0 }" />
										<Table
											items="{viewModel>retryHistory}"
											visible="{= ${viewModel>retryHistory}.length > 0 }"
											mode="None">
											<columns>
												<Column width="12rem"><Text text="{i18n>colTimestamp}" /></Column>
												<Column><Text text="Result" /></Column>
											</columns>
											<items>
												<ColumnListItem>
													<Text text="{viewModel>timestamp}" />
													<Text text="{viewModel>result}" />
												</ColumnListItem>
											</items>
										</Table>
									</VBox>
								</Panel>
								<HBox class="sapUiSmallMargin" visible="{= ${viewModel>status} !== 'Resolved' }">
									<Button
										text="{i18n>retryBtn}"
										type="Emphasized"
										icon="sap-icon://refresh"
										press=".onRetryPress"
										class="sapUiTinyMarginEnd" />
									<Button
										text="{i18n>resolveBtn}"
										type="Transparent"
										icon="sap-icon://accept"
										press=".onResolvePress" />
								</HBox>
							</VBox>
						</VBox>
					</CustomListItem>
				</List>
			</VBox>
		</content>
	</Page>

</mvc:View>
